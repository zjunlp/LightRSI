{
    "name": "lightrsi",
    "private": true,
    "version": "0.1.0-beta.1",
    "description": "A modular runtime for building, evaluating, and safely deploying recursive improvement loops in long-running LLM agents",
    "scripts": {
        "build": "pnpm -r build",
        "typecheck": "pnpm -r typecheck",
        "check:boundaries": "node scripts/check-package-boundaries.mjs",
        "graph:packages": "node scripts/check-package-boundaries.mjs --graph",
        "lightrsi:build": "npm --prefix components/products/cli run build",
        "lightrsi:install": "npm --prefix components/products/cli run install:bin",
        "lightrsi:typecheck": "npm --prefix components/products/cli run typecheck",
        "lightrsi:test": "npm --prefix components/products/cli test",
        "cleaner:install:codex": "node scripts/install-cleaner.mjs codex",
        "cleaner:install:claude-code": "node scripts/install-cleaner.mjs claude-code",
        "cleaner:install:test": "node --test scripts/tests/install-cleaner.test.mjs",
        "cleaner:demo:codex": "tsx scripts/cleaner-cli-demo.ts",
        "component:pack:tokenpilot:openclaw": "npm --prefix components/adapters/openclaw run pack:release",
        "component:pack:tokenpilot:codex": "npm --prefix components/adapters/codex run pack:release",
        "component:pack:tokenpilot:claude-code": "npm --prefix components/adapters/claude-code run pack:release",
        "component:install:tokenpilot:openclaw": "npm --prefix components/adapters/openclaw run install:release",
        "plugin:pack:release": "npm --prefix components/adapters/openclaw run pack:release",
        "plugin:install:release": "npm --prefix components/adapters/openclaw run install:release",
        "release:verify": "node scripts/release/verify-version.mjs",
        "release:build:local": "bash scripts/release/build-local.sh"
    },
    "devDependencies": {
        "typescript": "^5.9.3",
        "tsx": "^4.21.0",
        "@types/node": "^24.3.0"
    },
    "workspaces": [
        "components/packages/*/*",
        "components/presets/*",
        "components/adapters/*",
        "components/products/*"
    ],
    "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
